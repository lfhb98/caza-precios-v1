# Copia este archivo como .env.local y reinicia `pnpm web` (no se sube a git).
# Las variables NEXT_PUBLIC_* se incrustan en el navegador: no pongas aquí nada secreto.

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# API a la que Next reenvía /api/*. Por defecto http://localhost:3000 (`pnpm api`).
# Producción: https://caza-precios-api.vercel.app
API_URL=
