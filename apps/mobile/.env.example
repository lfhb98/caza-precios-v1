# Copia este archivo como .env y reinicia Expo (el .env no se sube a git).
# Las variables EXPO_PUBLIC_* se incrustan en la app: no pongas aquí nada secreto.

# Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL de la API. Opcional en desarrollo: si se deja vacía, la app usa
# http://<IP del ordenador que ejecuta Expo>:3000, que sirve también desde un móvil
# en la misma red Wi-Fi. Obligatoria en builds (EAS) y debe ser https.
EXPO_PUBLIC_API_URL=
