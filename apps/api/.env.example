# Copia este archivo como .env y rellena los valores (el .env no se sube a git).

# Supabase → Connect → Connection string.
# Para la API: el pooler en modo transacción (puerto 6543).
# Para `pnpm db:migrate`: la conexión directa o el pooler en modo sesión (puerto 5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://<ref>.supabase.co

PORT=3000

# Orígenes del frontend web que pueden llamar a la API, separados por comas (vacío = ninguno).
CORS_ORIGINS=http://localhost:8081
