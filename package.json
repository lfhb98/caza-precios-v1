{
  "name": "caza-precios",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "api": "pnpm --filter @caza-precios/api run dev",
    "mobile": "pnpm --filter @caza-precios/mobile run start",
    "mobile:android": "pnpm --filter @caza-precios/mobile run android",
    "mobile:ios": "pnpm --filter @caza-precios/mobile run ios",
    "mobile:web": "pnpm --filter @caza-precios/mobile run web",
    "mobile:doctor": "pnpm --filter @caza-precios/mobile run doctor",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "check": "pnpm typecheck && pnpm mobile:doctor"
  }
}
