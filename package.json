{
  "name": "caza-precios",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "api": "pnpm --filter @caza-precios/api run dev",
    "api:test": "pnpm --filter @caza-precios/api run test",
    "api:db:generate": "pnpm --filter @caza-precios/api run db:generate",
    "api:db:migrate": "pnpm --filter @caza-precios/api run db:migrate",
    "mobile": "pnpm --filter @caza-precios/mobile run start",
    "mobile:android": "pnpm --filter @caza-precios/mobile run android",
    "mobile:ios": "pnpm --filter @caza-precios/mobile run ios",
    "mobile:web": "pnpm --filter @caza-precios/mobile run web",
    "mobile:doctor": "pnpm --filter @caza-precios/mobile run doctor",
    "web": "pnpm --filter @caza-precios/web run dev",
    "web:build": "pnpm --filter @caza-precios/web run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "check": "pnpm typecheck && pnpm test && pnpm mobile:doctor"
  }
}
